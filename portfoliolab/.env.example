# Optional. Every variable has a working local default in docker-compose.yml.
# Copy to .env and uncomment what you want to change; docker compose reads
# .env automatically.

# --- PostgreSQL (container) -------------------------------------------------
# POSTGRES_USER=portfoliolab
# POSTGRES_PASSWORD=portfoliolab
# POSTGRES_DB=portfoliolab

# --- App --------------------------------------------------------------------
# Host port. If you change it, change AUTH_URL to match.
# APP_PORT=3000
# AUTH_URL=http://localhost:3000

# Auth.js secret. The default is public: set your own before exposing the app.
#   openssl rand -base64 32
# AUTH_SECRET=

# "Try the demo" button (shared account, no password). Set to false to disable.
# DEMO_MODE=true

# Google sign-in (optional). Authorized redirect URI in Google Cloud console:
#   http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- Price data -------------------------------------------------------------
# true: generate simulated prices at startup (default).
# false: no simulated prices; use the Twelve Data import instead.
# SIMULATED_PRICES=true

# Twelve Data API key, used only by: docker compose --profile import up prices
# TWELVE_KEY=
