// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id           Int    @id @default(autoincrement())
  symbol       String @unique
  name         String
  sector       String
  subindustry  String
  headquarters String
  founded_year Int

  stockPrices     StockPrice[]
  stockOwnerships StockOwnership[]
  transactions    Transaction[]
}

model StockPrice {
  id        Int @id @default(autoincrement())
  companyId Int

  datetime   DateTime @db.Date
  openPrice  Decimal  @db.Decimal(10, 2)
  highPrice  Decimal  @db.Decimal(10, 2)
  lowPrice   Decimal  @db.Decimal(10, 2)
  closePrice Decimal  @db.Decimal(10, 2)
  volume     BigInt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, datetime])
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  money           Decimal  @db.Decimal(10, 2)
  stockOwnerships StockOwnership[]
  transactions    Transaction[]
}

model StockOwnership {
  id        Int @id @default(autoincrement())
  userId    Int
  companyId Int
  quantity  Int

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
}

model Transaction {
  id        Int @id @default(autoincrement())
  userId    Int
  companyId Int
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  datetime  DateTime @db.Timestamp(6)
  type String

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
}